# Copy to .env and adjust. .env is git-ignored; never commit real credentials.
# The scanner reads credentials only from the environment (or the AWS
# credentials chain) and never from the YAML config.

# --- PostgreSQL (standard libpq variables) ---------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=scanner_demo
PGUSER=scanner
PGPASSWORD=change-me
# PGSSLMODE=require

# --- AWS S3 -----------------------------------------------------------------
# Resolved by the standard boto3 chain: environment, ~/.aws/credentials
# profiles, SSO, container/instance roles. Prefer profiles or roles over
# static keys. Uncomment only what you need:
# AWS_PROFILE=default
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<your-access-key-id>
# AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
# AWS_SESSION_TOKEN=<your-session-token>
# Local S3-compatible endpoint (moto / MinIO / LocalStack):
# AWS_ENDPOINT_URL=http://localhost:5000
